-- ledaticground RFML: attested characterization receipt (pure Rail) — RECEIPT_CONTRACT v=2.
-- Binds a signal-characterization (the Rail-trained classifier's output over a capture) to
-- the receiving node under an Ed25519 signature, hash-chained + beacon-anchored, with a
-- round-trip verify + tamper check. Closes the PAOS provenance loop:
--   "this node, with THIS model build, produced these (possibly suspect) labels at this time."
--
-- v=2 upgrade (AC-5 / RFML-5):
--   * v=2 / type=FACT / node= / band= fields per RECEIPT_CONTRACT.md (A.1).
--   * RFML honesty slot carries TWO fields per the contract (A.3): health=<ok|degraded>
--     AND model=<exact tag from the source summary row>. A degraded record is STILL signed
--     truth — the broken classifier state is ATTESTED, not hidden (no-synthetic-evidence /
--     display-lies rules). RIGHT NOW the deployed serving path is the degraded V3-gain build
--     (rfml.jsonl: signal_windows==0, model tag rail-trained-audio-softmax-v3+novelty), so
--     health=degraded is the HONEST attestation until the serving feat-dim fix lands.
--   * Real beacon-anchored pulse_id/pulse_hex (read from the /tmp files the rollup stages).
--   * Real prev-hash chaining (read from the rollup-staged prev file; GENESIS for line 1).
--   * Appends one v=2 JSON line to data/rfml_receipts.jsonl via stdlib/file.rail append_line,
--     AND keeps writing the legacy single-object data/modclass_receipt.json for verify.rail.
--
-- The rollup driver (scripts/attest_rfml_rollup.sh) stages every variable input to /tmp;
-- Rail reads each via field_or with an honest fallback (NEVER pulse_id=0, NEVER wall-clock).
-- Run via the flock wrapper from the rail repo root so stdlib imports resolve:
--   bash scripts/railrun.sh <abs>/src/modclass_attest.rail

import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"
import "stdlib/file.rail"

field_or path def =
  let v = str_replace "\n" "" (read_file path)
  if v == "" then def else v

main =
  -- DEV signing key (NOT a production attestation authority — clearly labeled).
  -- AIS + RFML share this DEV seed for backward compat; the KIND / model / band fields
  -- disambiguate the receipts (RECEIPT_CONTRACT.md E.3).
  let seed = hex_to_bytes "a15a15a15a15a15a15a15a15a15a15a15a15a15a15a15a15a15a15a15a15a1500"
  let pk = ed25519_pk_from_sk seed
  let pk_hex = bytes_to_hex pk 32

  -- product = the characterization the classifier produced over the capture (the canonical
  -- label digest the rollup staged). product_sha256 commits to the LITERAL summary content,
  -- so the receipt can never claim a class spread the source row did not contain.
  let product = field_or "/tmp/modclass_result.txt" "PENDING_no_characterization"
  let product_hash = sha256_hex product

  -- Beacon anchor (staged by the rollup via scripts/fetch_beacon_pulse.sh). Honest fallback:
  -- pulse_id=PENDING_beacon_unreachable / pulse_hex=PENDING when the beacon is unreachable —
  -- the receipt is STILL signed+chained (the hash-chain is the local clock). NEVER 0.
  let pulse_id = field_or "/tmp/lg_pulse_id.txt" "PENDING_beacon_unreachable"
  let pulse_hex = field_or "/tmp/lg_pulse_hex.txt" "PENDING"

  -- prev-hash chaining: the rollup stages the tail chain_hash of data/rfml_receipts.jsonl
  -- (or GENESIS for line 1) to /tmp/rfml_prev_sha.txt.
  let prev = field_or "/tmp/rfml_prev_sha.txt" "GENESIS"

  -- Batch provenance BOUNDS (scrubbed source-row unix seconds + frame count). These are NOT
  -- the attestation clock (that is pulse_id); they bound which source rows the digest covers.
  let batch_start = field_or "/tmp/rfml_batch_start.txt" "PENDING_batch_start"
  let batch_end = field_or "/tmp/rfml_batch_end.txt" "PENDING_batch_end"
  let n = field_or "/tmp/rfml_batch_n.txt" "0"

  -- Node / station identity is file-driven; precise lat/lon is PENDING until GPS-PPS. We
  -- assert node identity + the model, never a fabricated receiver location.
  let sta = field_or "/Users/ledaticempire/projects/ledaticground/data/station_name.txt" "ledaticground-roof"
  let node = sta
  let band = "RFML-audio-classifier"
  let geo = field_or "/Users/ledaticempire/projects/ledaticground/data/station_geo.txt" "PENDING_needs_GPS_PPS"

  -- RFML honesty slot (RECEIPT_CONTRACT.md A.3): health + the EXACT model tag from the
  -- source summary row. The rollup computes health=degraded iff signal_windows==0 AND
  -- unknown_windows==windows (the V3-gain regression signature); otherwise health=ok. We
  -- read both as staged strings and attest them verbatim — a verifier sees which model
  -- version produced the labels and whether the node flagged itself degraded.
  let health = field_or "/tmp/rfml_health.txt" "degraded"
  let model = field_or "/tmp/rfml_model.txt" "rail-trained-audio-softmax-v3+novelty"

  -- v=2 FACT receipt — field order is LOAD-BEARING (the sig is over this exact string).
  let receipt = join "|" ["RFML_RECEIPT", "v=2", "type=FACT", cat ["node=", node], cat ["station=", sta], cat ["band=", band], cat ["geo=", geo], cat ["pulse_id=", pulse_id], cat ["pulse_hex=", pulse_hex], cat ["batch_start=", batch_start], cat ["batch_end=", batch_end], cat ["n=", n], cat ["health=", health], cat ["model=", model], cat ["product_sha256=", product_hash], cat ["prev=", prev], cat ["signer=", pk_hex]]
  let msg = string_to_bytes receipt
  let mlen = string_length_bytes receipt
  let sig = ed25519_sign seed msg mlen
  let sig_hex = bytes_to_hex sig 64

  let verify_ok = ed25519_verify pk msg mlen sig
  let tstr = cat [receipt, "X"]
  let tmsg = string_to_bytes tstr
  let tlen = string_length_bytes tstr
  let tamper_ok = ed25519_verify pk tmsg tlen sig
  let chain_hash = sha256_hex (cat [receipt, "|sig=", sig_hex])

  let _ = print (cat ["PRODUCT  ", product])
  let _ = print (cat ["HEALTH   ", health, "  MODEL ", model])
  let _ = print (cat ["RECEIPT  ", receipt])
  let _ = print (cat ["SIG      ", sig_hex])
  let _ = print (cat ["CHAIN    ", chain_hash])
  let _ = print (cat ["VERIFY   own-sig accepted = ", show verify_ok, " (want 1)"])
  let _ = print (cat ["TAMPER   modified-msg accepted = ", show tamper_ok, " (want 0)"])

  -- v=2 JSON ledger line. SPACE-AFTER-COLON on receipt/sig/signer/chain_hash is LOAD-BEARING
  -- (verify.rail's field_val matches the pattern "key": " WITH a space). Append to the
  -- chained per-stream ledger via append_line (NEVER append_file — not a runtime symbol).
  let jline = cat ["{\"v\":2,\"type\":\"FACT\",\"receipt\": \"", receipt, "\",\"sig\": \"", sig_hex, "\",\"signer\": \"", pk_hex, "\",\"chain_hash\": \"", chain_hash, "\"}"]
  let _ = append_line "/Users/ledaticempire/projects/ledaticground/data/rfml_receipts.jsonl" jline
  let _ = print "APPENDED data/rfml_receipts.jsonl"

  -- Legacy single-object write (backward compat with verify.rail single-object mode).
  let jrec = join "\n" ["{", cat ["  \"receipt\": \"", receipt, "\","], cat ["  \"sig\": \"", sig_hex, "\","], cat ["  \"signer\": \"", pk_hex, "\","], cat ["  \"chain_hash\": \"", chain_hash, "\""], "}"]
  let _ = write_file "/Users/ledaticempire/projects/ledaticground/data/modclass_receipt.json" jrec
  let _ = print "WROTE data/modclass_receipt.json"
  0
