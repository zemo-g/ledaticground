-- ledaticground RS41 rung 3: XOR-mask descramble + RS41 sync-word search (pure Rail).
-- Takes recovered NRZ channel bits (from rs41_demod, RS41 is byte-LSB-first on the wire),
-- packs them LSB-first into bytes (pack_bits/pack_one from beacon_decode.rail, verbatim),
-- searches the byte stream for the RS41 8-byte frame sync, and XOR-descrambles the
-- following FRAME_LEN bytes with the fixed 64-byte RS41 scramble mask M (cycled mod 64).
--
-- The RS41 64-byte XOR mask M is publicly documented (a fixed LCG-derived bit-reversed
-- sequence). It is baked here as an int-array literal (Rail's 63-bit ints overflow a
-- multiplicative PRNG, per CLAUDE.md, so the sequence is generated by gen_rs41_gen.py and
-- pasted -- /tmp/rs41_mask_rail.txt -- guaranteeing Python gen + Rail descramble use the
-- IDENTICAL literal). XOR via the bit_xor builtin.
--
-- Sync search: the whole RS41 frame INCLUDING the sync is scrambled on the wire; the sync
-- constant 0x86 0x35 F4 40 93 DF 1A 60 is the POST-descramble value. So at each candidate
-- byte offset we XOR the next 8 bytes with M[0..7] and test for the sync constant -- this
-- skips the leading 0x55 preamble naturally (mirror find_flag/flagmatch, 8-byte window).
--
-- Output: 'SYNC_OFFSET <byte>' then 'DESCRAMBLED <hex>' (hex over the wire so any 0x00 byte
-- survives -- char_from_int 0 returns "" would drop NULs; reuse hex8/hexd, no spaces).
--
-- Reads bits from a 'BITS <0101..>' file at /tmp/rs41_bits_in.txt (the demod output);
-- FRAME_LEN from /tmp/rs41_frame_len.txt (default 518). SYNTHETIC-ONLY.
--
-- Run: bash scripts/railrun.sh <ledaticground>/src/rs41_descramble.rail

foreign fopen path mode -> int
foreign fclose fp
foreign fread buf size count fp
foreign fseek fp offset whence
foreign ftell fp -> int

field_or path def =
  let v = str_replace "\n" "" (read_file path)
  if v == "" then def else v
pint_acc cs acc =
  if cs == [] then acc
  else
    let c = head cs
    let d = char_to_int c - 48
    if d < 0 then acc
    else if d > 9 then acc
    else pint_acc (tail cs) (acc * 10 + d)
pint s = pint_acc (chars s) 0

-- ---- bake the 64-byte RS41 scramble mask M (literal, from gen_rs41_gen.py) ----
build_mask m =
  let _ = arr_set m 0 0
  let _ = arr_set m 1 96
  let _ = arr_set m 2 18
  let _ = arr_set m 3 120
  let _ = arr_set m 4 10
  let _ = arr_set m 5 110
  let _ = arr_set m 6 24
  let _ = arr_set m 7 112
  let _ = arr_set m 8 5
  let _ = arr_set m 9 103
  let _ = arr_set m 10 23
  let _ = arr_set m 11 127
  let _ = arr_set m 12 15
  let _ = arr_set m 13 106
  let _ = arr_set m 14 29
  let _ = arr_set m 15 119
  let _ = arr_set m 16 2
  let _ = arr_set m 17 99
  let _ = arr_set m 18 17
  let _ = arr_set m 19 123
  let _ = arr_set m 20 9
  let _ = arr_set m 21 108
  let _ = arr_set m 22 26
  let _ = arr_set m 23 115
  let _ = arr_set m 24 7
  let _ = arr_set m 25 101
  let _ = arr_set m 26 20
  let _ = arr_set m 27 125
  let _ = arr_set m 28 12
  let _ = arr_set m 29 104
  let _ = arr_set m 30 31
  let _ = arr_set m 31 117
  let _ = arr_set m 32 1
  let _ = arr_set m 33 97
  let _ = arr_set m 34 19
  let _ = arr_set m 35 121
  let _ = arr_set m 36 11
  let _ = arr_set m 37 111
  let _ = arr_set m 38 25
  let _ = arr_set m 39 113
  let _ = arr_set m 40 4
  let _ = arr_set m 41 102
  let _ = arr_set m 42 22
  let _ = arr_set m 43 126
  let _ = arr_set m 44 14
  let _ = arr_set m 45 107
  let _ = arr_set m 46 28
  let _ = arr_set m 47 118
  let _ = arr_set m 48 3
  let _ = arr_set m 49 98
  let _ = arr_set m 50 16
  let _ = arr_set m 51 122
  let _ = arr_set m 52 8
  let _ = arr_set m 53 109
  let _ = arr_set m 54 27
  let _ = arr_set m 55 114
  let _ = arr_set m 56 6
  let _ = arr_set m 57 100
  let _ = arr_set m 58 21
  let _ = arr_set m 59 124
  let _ = arr_set m 60 13
  let _ = arr_set m 61 105
  let _ = arr_set m 62 30
  let _ = arr_set m 63 116
  0

-- ---- the 8-byte RS41 frame sync (post-descramble constant) ----
sync_byte k =
  if k == 0 then 134
  else if k == 1 then 53
  else if k == 2 then 244
  else if k == 3 then 64
  else if k == 4 then 147
  else if k == 5 then 223
  else if k == 6 then 26
  else 96

-- ---- parse a 'BITS <0101..>' file -> int array of bits ----
-- walk the char list after "BITS "; '0'/'1' -> bit, else stop. Returns count via icell.
bits_from_chars cs arr icell =
  if cs == [] then 0
  else
    let c = head cs
    let i = arr_get icell 0
    if c == "0" then
      let _ = arr_set arr i 0
      let _ = arr_set icell 0 (i + 1)
      bits_from_chars (tail cs) arr icell
    else if c == "1" then
      let _ = arr_set arr i 1
      let _ = arr_set icell 0 (i + 1)
      bits_from_chars (tail cs) arr icell
    else 0

-- ---- pack bits LSB-first into bytes (verbatim beacon_decode.rail) ----
pack_one bits base i acc =
  if i >= 8 then acc
  else pack_one bits base (i + 1) (bit_or acc (shl (arr_get bits (base + i)) i))
pack_bits bits nbytes obytes j =
  if j >= nbytes then 0
  else
    let _ = arr_set obytes j (pack_one bits (8 * j) 0 0)
    pack_bits bits nbytes obytes (j + 1)

-- ---- sync search: at offset i, descrambled[i+k] = bytes[i+k] ^ M[k] must == sync[k] ----
sm_acc bytes m i k cell =
  if k >= 8 then 0
  else
    let dv = bit_xor (arr_get bytes (i + k)) (arr_get m k)
    let _ = arr_set cell 0 ((arr_get cell 0) + (if dv == (sync_byte k) then 1 else 0))
    sm_acc bytes m i (k + 1) cell
syncmatch bytes m i =
  let cell = arr_new 1 0
  let _ = sm_acc bytes m i 0 cell
  if (arr_get cell 0) == 8 then 1 else 0
find_sync bytes m nb i =
  if (i + 8) > nb then (0 - 1)
  else if (syncmatch bytes m i) == 1 then i else find_sync bytes m nb (i + 1)

-- ---- descramble FRAME_LEN bytes from offset: out[i] = frame[off+i] ^ M[i % 64] ----
descr bytes m off out flen i =
  if i >= flen then 0
  else
    let _ = arr_set out i (bit_xor (arr_get bytes (off + i)) (arr_get m (i % 64)))
    descr bytes m off out flen (i + 1)

-- ---- hex (no spaces) ----
hexd v = str_sub "0123456789abcdef" v 1
hex8 v = cat [hexd (bit_and (shr v 4) 15), hexd (bit_and v 15)]
hexout out i n acc =
  if i >= n then acc
  else hexout out (i + 1) n (cat [acc, hex8 (arr_get out i)])

main =
  let flen = pint (field_or "/tmp/rs41_frame_len.txt" "518")
  let m = arr_new 64 0
  let _ = build_mask m
  -- read the BITS line (from demod). field_or returns the whole file content trimmed.
  let raw = read_file "/tmp/rs41_bits_in.txt"
  let bpos = str_find "BITS " raw
  let rawlen = length raw
  let after = if bpos < 0 then raw else str_sub raw (bpos + 5) (rawlen - (bpos + 5))
  let bits = arr_new (rawlen + 8) 0
  let icell = arr_new 1 0
  let _ = bits_from_chars (chars after) bits icell
  let nbits = arr_get icell 0
  let nb = nbits / 8
  let bytes = arr_new nb 0
  let _ = pack_bits bits nb bytes 0
  let _ = print (cat ["INFO bits=", show nbits, " bytes=", show nb, " frame_len=", show flen])
  let off = find_sync bytes m nb 0
  let _ = print (cat ["SYNC_OFFSET ", show off])
  if off < 0 then
    let _ = print "DESCRAMBLE_FAIL no sync"
    0
  else
    let out = arr_new flen 0
    let _ = descr bytes m off out flen 0
    let _ = print (cat ["DESCRAMBLED ", hexout out 0 flen ""])
    0
