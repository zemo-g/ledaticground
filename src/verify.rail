-- ledaticground: independent receipt verifier (pure Rail) — "the verifier is Rail".
-- COLD re-checks a signed receipt with NO shared state with the signer. Two modes:
--
--   (1) SINGLE-OBJECT (backward compat, default). Reads data/receipt.json (one
--       {receipt,sig,signer,chain_hash} object) and re-checks:
--         (a) the Ed25519 signature over the receipt string under the stated signer key
--         (b) the SHA-256 chain hash = sha256(receipt | "|sig=" | sig)
--
--   (2) JSONL LEDGER WALK (AC-3). When /tmp/lg_verify_target.txt names a per-stream
--       chained ledger (e.g. data/ais_receipts.jsonl), walk EVERY line and verify:
--         (a) each line's Ed25519 signature over its receipt string
--         (b) each line's chain_hash = sha256(receipt | "|sig=" | sig)  (re-derived)
--         (c) the prev= POINTER links the chain: line[0].receipt has prev=GENESIS,
--             and line[k].receipt has prev=<line[k-1].chain_hash>. A broken link or a
--             bad sig = FAIL with the offending line index.
--         (d) cross-ledger derived_from resolution: a type=INFERENCE line carries
--             derived_from=<fact_chain_hash>; that hash MUST appear as a chain_hash in
--             one of the FACT ledgers listed in /tmp/lg_verify_facts.txt. An
--             unresolvable derived_from = REJECT at that line.
--
-- Anyone can run this to verify a proof-of-reception. Run from the rail repo dir via:
--   bash scripts/railrun.sh /Users/ledaticempire/projects/ledaticground/src/verify.rail
--
-- Config is FILE-BASED (Rail's shell() inherits no env/PATH; same field_or idiom the
-- signers use). To select JSONL-walk mode, stage:
--   /tmp/lg_verify_target.txt  -> abs path of the ledger to walk (one line)
--   /tmp/lg_verify_facts.txt   -> newline-separated abs paths of FACT ledgers whose
--                                 chain_hashes resolve INFERENCE derived_from (optional;
--                                 absent => derived_from resolves against the target ledger
--                                 itself, which still catches dangling pointers).
-- Absent/empty /tmp/lg_verify_target.txt => single-object mode on data/receipt.json.

import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"

-- ===== WAVE C: PHYSICS RE-RUN (physicify with teeth) =====
-- For a PHYSICS_BINDING_RECEIPT (A.7) the verifier, AFTER the sig+chain+prev+derived_from
-- checks pass, RE-RUNS the physics: it recomputes the SINGLE-point residual from the cited
-- tle_sha256 (TLE staged at /tmp/lg_verify_tle.txt), the claimed_geo, the committed
-- t_shift_s/const_off_hz, and the committed measured track (meas_sha256, staged at
-- /tmp/lg_verify_meas.txt + its snapshot times at /tmp/lg_verify_times.txt) -- using THE SAME
-- SGP4 query path (doppler_range.rail, inlined verbatim below) the emitter committed. If
-- |recomputed - residual_hz| > repro_tol_hz it REJECTS with "physics residual unreproducible",
-- EVEN WHEN the Ed25519 signature is perfectly valid. A valid signature over a FABRICATED
-- residual MUST fail: the signature proves "the signer wrote this number", the physics re-run
-- proves "this number is what the cited orbit+geo+track actually yields". The claim is ALWAYS
-- "the cost of an undetected lie scales with the conspiracy required" -- to forge a passing
-- binding the liar must also forge a TLE+track whose SGP4 single-point residual matches the
-- fabricated number AND whose digests match the cited tle_sha256/meas_sha256. physics_ok is
-- NEVER re-interpreted as "verified true"; this only re-checks the RECORDED mechanism number.
-- The math is byte-identical to src/doppler_range.rail / src/binding_attest.rail so the
-- recomputed Doppler equals the emitter's single-point eval for the same staged inputs.

foreign sin x -> float
foreign cos x -> float
foreign sqrt x -> float
foreign pow x y -> float
foreign atan2 y x -> float
foreign floor x -> float

-- field_or: read a /tmp staging file, strip trailing newline; absent/empty -> default.
field_or path def =
  let v = str_replace "\n" "" (read_file path)
  if v == "" then def else v

-- extract a JSON string field value:  "<key>": "<value>"  (space-after-colon, per contract B.2)
field_val json key =
  let pat = cat ["\"", key, "\": \""]
  let i = str_find pat json
  if i < 0 then ""
  else
    let start = i + (string_length_bytes pat)
    let rest = str_sub json start (string_length_bytes json - start)
    let q = str_find "\"" rest
    if q < 0 then rest else str_sub rest 0 q

-- extract a |key=value| field from the pipe-joined RECEIPT string. Value runs to the
-- next "|" or to end-of-string. Returns "" if the key is absent.
pipe_field receipt key =
  let pat = cat ["|", key, "="]
  let i = str_find pat receipt
  if i < 0 then ""
  else
    let start = i + (string_length_bytes pat)
    let rest = str_sub receipt start (string_length_bytes receipt - start)
    let bar = str_find "|" rest
    if bar < 0 then rest else str_sub rest 0 bar

-- ===== CORE CHECK: re-derive sig + chain over one receipt line/object =====
-- returns (sigok, chainok) for the given receipt/sig/signer/stored-chain quartet.
check_sig receipt sighex signerhex =
  let pk = hex_to_bytes signerhex
  let sig = hex_to_bytes sighex
  let msg = string_to_bytes receipt
  let mlen = string_length_bytes receipt
  ed25519_verify pk msg mlen sig

calc_chain receipt sighex = sha256_hex (cat [receipt, "|sig=", sighex])

-- ===== SINGLE-OBJECT MODE (backward compat) =====
verify_single =
  let json = read_file "/Users/ledaticempire/projects/ledaticground/data/receipt.json"
  let receipt = field_val json "receipt"
  let sighex = field_val json "sig"
  let signerhex = field_val json "signer"
  let chainstored = field_val json "chain_hash"

  let sigok = check_sig receipt sighex signerhex
  let chaincalc = calc_chain receipt sighex
  let chainok = if chaincalc == chainstored then 1 else 0

  let _ = print (cat ["receipt: ", receipt])
  let _ = print (cat ["signer:  ", signerhex])
  let _ = print (cat ["signature valid    = ", show sigok, "  (want 1)"])
  let _ = print (cat ["chain hash matches  = ", show chainok, "  (want 1)"])
  let verdict = if sigok == 1 then (if chainok == 1 then 1 else 0) else 0
  let _ = print (cat ["==> RECEIPT ", if verdict == 1 then "VALID" else "INVALID"])
  verdict

-- ===== JSONL LEDGER WALK MODE (AC-3) =====

-- A line is "real" if it contains a receipt field. (Trailing blank line from the file
-- read is skipped.) Use a named predicate — filter-with-lambda can segfault.
is_ledger_line s = str_contains "\"receipt\": \"" s

-- Load every FACT-ledger chain_hash into one blob for derived_from resolution. The blob
-- is a "\n"-joined list of chain_hash values wrapped in markers so a substring search for
-- "[<hash>]" cannot be fooled by a prefix collision. We accumulate over the FACT ledger
-- paths named (newline-separated) in /tmp/lg_verify_facts.txt.
chain_marker h = cat ["[", h, "]"]

-- collect markers for every chain_hash JSON field across one ledger's lines
ledger_markers_for lines =
  if lines == [] then ""
  else
    let ln = head lines
    let rest = ledger_markers_for (tail lines)
    if is_ledger_line ln then
      let ch = field_val ln "chain_hash"
      cat [chain_marker ch, "\n", rest]
    else rest

-- build the FACT chain-hash lookup blob from the newline-separated fact-ledger path list
build_fact_blob paths =
  if paths == [] then ""
  else
    -- split "\n" leaves no newline in the entry; guard the trailing empty token only.
    -- (trim is compile-only, NOT a runtime symbol — same trap as append_file.)
    let p = head paths
    let rest_blob = build_fact_blob (tail paths)
    if p == "" then rest_blob
    else
      let content = read_file p
      let lines = split "\n" content
      cat [ledger_markers_for lines, rest_blob]

-- resolve one derived_from hash against the fact blob. 1 if [<hash>] present, else 0.
resolve_derived_from fact_blob h =
  if str_contains (chain_marker h) fact_blob then 1 else 0

-- ===== WAVE D: two-parent derived_from + inner co-signature re-verification =====
-- A MESH_WITNESS_RECEIPT (sec A.8) carries derived_from = <factA_chain_hash>;<factB_chain_hash>
-- (a ";"-joined TWO-parent value) and the inner co-signatures sigA/sigB + signerA/signerB. The
-- verifier MUST: (1) str_split ";" and resolve EACH parent against the FACT ledgers (fail loud if
-- EITHER is unresolvable), and (2) re-verify each inner co-signature over the resolved FACT receipt
-- STRING under its stated signer. Single-parent derived_from (no ";") falls through unchanged.

-- A FACT-line lookup blob keyed by chain_hash. Each FACT line is wrapped as:
--   <<<LINE[<chain_hash>] <json_line> >>>END\n
-- so fact_line_for can find the marker [<chain_hash>] and extract the FULL json line that follows
-- (up to the >>>END sentinel). Distinct from build_fact_blob (markers-only, existence checks) so
-- the single-parent path stays byte-identical. Newline-free sentinels avoid split collisions.
fact_open = "<<<LINE"
fact_close = ">>>END"

ledger_lines_for lines =
  if lines == [] then ""
  else
    let ln = head lines
    let rest = ledger_lines_for (tail lines)
    if is_ledger_line ln then
      let ch = field_val ln "chain_hash"
      cat [fact_open, chain_marker ch, " ", ln, " ", fact_close, "\n", rest]
    else rest

build_fact_lines_blob paths =
  if paths == [] then ""
  else
    let p = head paths
    let rest_blob = build_fact_lines_blob (tail paths)
    if p == "" then rest_blob
    else
      let content = read_file p
      let lines = split "\n" content
      cat [ledger_lines_for lines, rest_blob]

-- find the FACT json line whose chain_hash == h (or "" if absent). Locates the marker
-- fact_open ++ [<h>] ++ " ", then returns everything up to the next " >>>END".
fact_line_for lines_blob h =
  let pat = cat [fact_open, chain_marker h, " "]
  let i = str_find pat lines_blob
  if i < 0 then ""
  else
    let start = i + (string_length_bytes pat)
    let rest = str_sub lines_blob start (string_length_bytes lines_blob - start)
    let e = str_find (cat [" ", fact_close]) rest
    if e < 0 then "" else str_sub rest 0 e

-- re-verify an inner co-signature over the FACT receipt STRING that a parent chain_hash resolves to.
--   lines_blob = the FACT-line lookup blob
--   parent_h   = the parent chain_hash (factA or factB)
--   sighex     = the inner sig (sigA or sigB) carried in the MESH receipt
--   signerhex  = the inner signer pubkey (signerA or signerB)
-- returns 1 if the parent resolves AND the inner sig verifies over its FACT receipt string, else 0.
inner_sig_ok lines_blob parent_h sighex signerhex =
  let factline = fact_line_for lines_blob parent_h
  if factline == "" then 0
  else
    let fact_receipt = field_val factline "receipt"
    if fact_receipt == "" then 0
    else check_sig fact_receipt sighex signerhex

-- resolve a (possibly two-parent) derived_from value. existence-only (per parent), 1/0.
-- single-parent (no ";") -> identical to resolve_derived_from. two-parent -> BOTH must resolve.
resolve_derived_multi fact_blob dfrom =
  let parts = str_split ";" dfrom
  if (length parts) <= 1 then resolve_derived_from fact_blob dfrom
  else
    let h0 = head parts
    let h1 = head (tail parts)
    let r0 = resolve_derived_from fact_blob h0
    let r1 = resolve_derived_from fact_blob h1
    if r0 == 1 then (if r1 == 1 then 1 else 0) else 0

-- mesh inner-sig re-verification for a MESH_WITNESS_RECEIPT line. Extracts the two parents from
-- the ";"-joined derived_from, plus sigA/sigB/signerA/signerB from the receipt, and re-verifies
-- EACH inner co-signature over the FACT receipt string the corresponding parent resolves to.
-- returns 1 only if BOTH inner sigs verify (and both parents resolve to a real FACT receipt).
-- Non-mesh INFERENCE lines (single parent, no sigA) skip this -> 1 (handled by the caller).
mesh_inner_ok lines_blob receipt =
  let dfrom = pipe_field receipt "derived_from"
  let parts = str_split ";" dfrom
  let is_mesh = str_contains "MESH_WITNESS_RECEIPT" receipt
  -- inner co-sig re-verification applies ONLY to a MESH_WITNESS_RECEIPT (the kind that carries
  -- sigA/sigB + a two-parent derived_from). A single-parent INFERENCE, or any other kind, -> 1.
  if is_mesh == 0 then 1
  else if (length parts) <= 1 then 1
  else
    let hA = head parts
    let hB = head (tail parts)
    let sigA = pipe_field receipt "sigA"
    let sigB = pipe_field receipt "sigB"
    let signerA = pipe_field receipt "signerA"
    let signerB = pipe_field receipt "signerB"
    let okA = inner_sig_ok lines_blob hA sigA signerA
    let okB = inner_sig_ok lines_blob hB sigB signerB
    if okA == 1 then (if okB == 1 then 1 else 0) else 0

-- ===================================================================================
-- WAVE C: SGP4 single-point Doppler re-run -- VERBATIM math from src/doppler_range.rail
-- (== src/binding_attest.rail's inlined copy), so the recomputed Doppler at t_eval equals
-- the emitter's committed single-point eval for the same TLE+geo+fc. Element/observer state
-- lives in one 26-slot float array `e` (same layout doppler_range.rail documents).
-- ===================================================================================
asin_ x = atan2 x (sqrt (1.0 - x * x))
fmod_ a b = a - (floor (a / b)) * b
fdiff a b = if a > b then a - b else b - a

kepler_iter e m ecur k =
  if k == 0 then ecur
  else
    let f = ecur - e * (sin ecur) - m
    let fp = 1.0 - e * (cos ecur)
    let enext = ecur - f / fp
    kepler_iter e m enext (k - 1)

solve_kepler e m = kepler_iter e m m 8

gmst_rad jd d2r =
  let d = jd - 2451545.0
  let t = d / 36525.0
  let g = 280.46061837 + 360.98564736629 * d + 0.000387933 * t * t - (t * t * t) / 38710000.0
  let gm = fmod_ g 360.0
  let gpos = if gm < 0.0 then gm + 360.0 else gm
  gpos * d2r

compute_elaz e t o =
  let a = float_arr_get e 0
  let ecc = float_arr_get e 1
  let incl = float_arr_get e 2
  let raan0 = float_arr_get e 3
  let argp0 = float_arr_get e 4
  let m0 = float_arr_get e 5
  let raandot = float_arr_get e 6
  let argpdot = float_arr_get e 7
  let mdot = float_arr_get e 8
  let jde = float_arr_get e 9
  let ox = float_arr_get e 10
  let oy = float_arr_get e 11
  let oz = float_arr_get e 12
  let ophi = float_arr_get e 13
  let olam = float_arr_get e 14
  let d2r = float_arr_get e 15
  let mm = m0 + mdot * t
  let raan = raan0 + raandot * t
  let argp = argp0 + argpdot * t
  let ea = solve_kepler ecc mm
  let r = a * (1.0 - ecc * (cos ea))
  let nu = atan2 ((sqrt (1.0 + ecc)) * (sin (ea / 2.0))) ((sqrt (1.0 - ecc)) * (cos (ea / 2.0)))
  let nu2 = nu * 2.0
  let xo = r * (cos nu2)
  let yo = r * (sin nu2)
  let cosO = cos raan
  let sinO = sin raan
  let cosw = cos argp
  let sinw = sin argp
  let cosi = cos incl
  let sini = sin incl
  let xeci = xo * ((cosO * cosw) - (sinO * sinw * cosi)) - yo * ((cosO * sinw) + (sinO * cosw * cosi))
  let yeci = xo * ((sinO * cosw) + (cosO * sinw * cosi)) - yo * ((sinO * sinw) - (cosO * cosw * cosi))
  let zeci = xo * (sinw * sini) + yo * (cosw * sini)
  let jd_obs = jde + t / 86400.0
  let g = gmst_rad jd_obs d2r
  let cg = cos g
  let sg = sin g
  let xe = xeci * cg + yeci * sg
  let ye = (0.0 - xeci) * sg + yeci * cg
  let ze = zeci
  let rx = xe - ox
  let ry = ye - oy
  let rz = ze - oz
  let slat = sin ophi
  let clat = cos ophi
  let slon = sin olam
  let clon = cos olam
  let east = (0.0 - slon) * rx + clon * ry
  let north = (0.0 - slat) * clon * rx - slat * slon * ry + clat * rz
  let up = clat * clon * rx + clat * slon * ry + slat * rz
  let rng = sqrt (rx * rx + ry * ry + rz * rz)
  let elr = asin_ (up / rng)
  let azr = atan2 east north
  let eldeg = elr / d2r
  let azd = azr / d2r
  let azpos = if azd < 0.0 then azd + 360.0 else azd
  let _ = float_arr_set o 0 eldeg
  let _ = float_arr_set o 1 azpos
  let _ = float_arr_set o 2 rng
  0

set_observer e lat_deg lon_deg alt_km d2r twopi mu re j2 fc =
  let phi = lat_deg * d2r
  let lam = lon_deg * d2r
  let sphi = sin phi
  let cphi = cos phi
  let ae = 6378.137
  let ff = 1.0 / 298.257223563
  let e2 = ff * (2.0 - ff)
  let nlat = ae / (sqrt (1.0 - e2 * sphi * sphi))
  let ox = (nlat + alt_km) * cphi * (cos lam)
  let oy = (nlat + alt_km) * cphi * (sin lam)
  let oz = (nlat * (1.0 - e2) + alt_km) * sphi
  let _ = float_arr_set e 10 ox
  let _ = float_arr_set e 11 oy
  let _ = float_arr_set e 12 oz
  let _ = float_arr_set e 13 phi
  let _ = float_arr_set e 14 lam
  let _ = float_arr_set e 15 d2r
  let _ = float_arr_set e 21 mu
  let _ = float_arr_set e 22 re
  let _ = float_arr_set e 23 j2
  let _ = float_arr_set e 24 twopi
  let _ = float_arr_set e 25 fc
  0

set_elements_from_tle e l1 l2 =
  let incd = parse_float (str_sub l2 8 8)
  let raand = parse_float (str_sub l2 17 8)
  let ecc = parse_float (cat ["0.", str_sub l2 26 7])
  let argpd = parse_float (str_sub l2 34 8)
  let mad = parse_float (str_sub l2 43 8)
  let mmd = parse_float (str_sub l2 52 11)
  let yy = parse_int (str_sub l1 18 2)
  let year = 2000 + yy
  let ddf = parse_float (str_sub l1 20 12)
  let jd_jan1 = int_to_float (367 * year - 7 * year / 4) + 1721044.5
  let jd_epoch = jd_jan1 + (ddf - 1.0)
  let d2r = float_arr_get e 15
  let twopi = float_arr_get e 24
  let mu = float_arr_get e 21
  let re = float_arr_get e 22
  let j2 = float_arr_get e 23
  let jd_now = float_arr_get e 20
  let n0 = mmd * twopi / 86400.0
  let a = pow (mu / (n0 * n0)) (1.0 / 3.0)
  let incl = incd * d2r
  let p = a * (1.0 - ecc * ecc)
  let rp = re / p
  let factor = 1.5 * j2 * rp * rp
  let cosi = cos incl
  let sini = sin incl
  let raandot = (0.0 - n0) * factor * cosi
  let argpdot = n0 * factor * (2.0 - 2.5 * sini * sini)
  let mdot = n0 * (1.0 + factor * (sqrt (1.0 - ecc * ecc)) * (1.0 - 1.5 * sini * sini))
  let t0 = (jd_now - jd_epoch) * 86400.0
  let _ = float_arr_set e 0 a
  let _ = float_arr_set e 1 ecc
  let _ = float_arr_set e 2 incl
  let _ = float_arr_set e 3 (raand * d2r)
  let _ = float_arr_set e 4 (argpd * d2r)
  let _ = float_arr_set e 5 (mad * d2r)
  let _ = float_arr_set e 6 raandot
  let _ = float_arr_set e 7 argpdot
  let _ = float_arr_set e 8 mdot
  let _ = float_arr_set e 9 jd_epoch
  let _ = float_arr_set e 17 t0
  0

set_now_unix e now_unix_f =
  let jd_now = now_unix_f / 86400.0 + 2440587.5
  let _ = float_arr_set e 19 now_unix_f
  let _ = float_arr_set e 20 jd_now
  jd_now

range_at e t o =
  let _ = compute_elaz e t o
  float_arr_get o 2

doppler_at e t o =
  let r1 = range_at e t o
  let r2 = range_at e (t + 1.0) o
  let fc = float_arr_get e 25
  (r1 - r2) * fc / 299792.458

doppler_at_unix e unix_f o =
  let now_unix = float_arr_get e 19
  let t0 = float_arr_get e 17
  let t = t0 + (unix_f - now_unix)
  doppler_at e t o

-- ===================================================================================
-- WAVE C helpers: parse claimed_geo, the measured track + times, reproduce the eval point.
-- ===================================================================================

-- round-to-nearest via floor(x+0.5) -- matches the rollup's int(round(...)) for the eval time.
round_ x = floor (x + 0.5)

-- parse claimed_geo "lat,lon,altkm_SYNTH" -> field i (0=lat,1=lon). Strips the _SYNTH suffix and
-- any trailing "km" on the alt; lat/lon are plain floats. Returns "" if the field is absent.
geo_field claimed i =
  let core = str_replace "_SYNTH" "" claimed
  let parts = str_split "," core
  if (length parts) <= i then ""
  else nth_str parts i

-- nth element of a string list (named, not a lambda; filter-with-lambda can segfault).
nth_str xs i =
  if i <= 0 then head xs
  else nth_str (tail xs) (i - 1)

-- count real DOP lines in the measured track ("DOP <w> <peak> <centroid>"); used for nw.
is_dop_line s = str_contains "DOP " s

-- the j-th token (space-separated) of a line, 0-based. token 0 = "DOP", 2=peak, 3=centroid.
line_tok line j =
  let parts = str_split " " line
  if (length parts) <= j then "" else nth_str parts j

-- count DOP lines
count_dop lines acc =
  if lines == [] then acc
  else
    let ln = head lines
    let na = if is_dop_line ln then acc + 1 else acc
    count_dop (tail lines) na

-- the centroid (or peak) Doppler of the k-th DOP line (0-based over DOP lines only).
-- estimator "peak" -> token 2 ; anything else (centroid) -> token 3. Matches the rollup's
-- arr = peak_w/cent_w selection. Returns 0.0 if k is out of range.
dop_at_k lines k want_peak cur =
  if lines == [] then 0.0
  else
    let ln = head lines
    if is_dop_line ln then
      if cur == k then
        let tk = if want_peak == 1 then line_tok ln 2 else line_tok ln 3
        parse_float tk
      else dop_at_k (tail lines) k want_peak (cur + 1)
    else dop_at_k (tail lines) k want_peak cur

-- the k-th snapshot unix time (0-based) from /tmp/lg_verify_times.txt lines. The times file
-- mirrors the rollup's BIND_TIMES: "snap <unix>" rows (one per measured window, in order).
-- token 1 of a "snap <unix>" line is the unix time. Parsed as an INTEGER (parse_int, not
-- parse_float): the snapshot unix times are integers, and integer subtraction (se - first_snap)
-- DODGES the self-loop float miscompile that segfaults when two parse_float results flowing out
-- of a recursive fn are subtracted (tdoa.rail:50-58 float-accumulator discipline). Returns 0 if absent.
is_snap_line s = str_contains "snap " s
snap_int_at_k lines k cur =
  if lines == [] then 0
  else
    let ln = head lines
    if is_snap_line ln then
      if cur == k then parse_int (line_tok ln 1)
      else snap_int_at_k (tail lines) k (cur + 1)
    else snap_int_at_k (tail lines) k (cur + 1)
count_snap lines acc =
  if lines == [] then acc
  else
    let ln = head lines
    let na = if is_snap_line ln then acc + 1 else acc
    count_snap (tail lines) na

-- WAVE C, FULL-PASS RMS: accumulate the sum of squared physics residuals over ALL nw measured
-- windows into sacc[0]. doppler_at_unix is anchor-free (t = unix - epoch; now_unix cancels), so
-- one set_observer/set_elements_from_tle suffices and we re-eval the prediction per window k.
-- resid_k = measured_k - (predicted_k + const_off). Float discipline (tdoa.rail:50-58): route
-- every float through acc[*] before arithmetic; thread ONLY ints + array refs through the self-call,
-- never a bare float (which trips the self-loop miscompile). The running sum lives in sacc[0].
rms_accum e o meas_lines time_lines first_snap t_shift const_off want_peak nw k acc sacc =
  if k >= nw then 0
  else
    let snap_k = snap_int_at_k time_lines k 0
    let t_eval = round_ ((int_to_float first_snap) + (int_to_float (snap_k - first_snap)) + t_shift)
    let _ = float_arr_set acc 0 (doppler_at_unix e t_eval o)
    let _ = float_arr_set acc 1 const_off
    let _ = float_arr_set acc 2 (dop_at_k meas_lines k want_peak 0)
    let _ = float_arr_set acc 3 ((float_arr_get acc 0) + (float_arr_get acc 1))
    let r = fdiff (float_arr_get acc 3) (float_arr_get acc 2)
    let _ = float_arr_set sacc 0 ((float_arr_get sacc 0) + (r * r))
    rms_accum e o meas_lines time_lines first_snap t_shift const_off want_peak nw (k + 1) acc sacc

-- ===================================================================================
-- THE WAVE C PHYSICS RE-RUN: recompute the single-point residual for a binding receipt and
-- compare to the COMMITTED residual_hz within repro_tol_hz. Returns 1 (reproduces) / 0 (FAIL).
-- Staging (verify_binding.sh writes these):
--   /tmp/lg_verify_tle.txt    cited TLE (l1\nl2)  -- its sha256 MUST equal receipt tle_sha256
--   /tmp/lg_verify_meas.txt   cited measured track (doppler_real DOP lines) -- sha256 == meas_sha256
--   /tmp/lg_verify_times.txt  "snap <unix>" rows for the measured windows (eval-index -> t_eval)
-- A digest mismatch on the staged TLE/track means the verifier is being fed a DIFFERENT artifact
-- than the receipt cited -> can't honestly re-run -> FAIL (treat as unreproducible).
-- ===================================================================================
physics_recompute receipt idx =
  let residual_hz = parse_int (pipe_field receipt "residual_hz")
  let repro_tol_hz = parse_int (pipe_field receipt "repro_tol_hz")
  let t_shift_s = parse_float (pipe_field receipt "t_shift_s")
  let const_off_hz = parse_float (pipe_field receipt "const_off_hz")
  let estimator = pipe_field receipt "estimator"
  let want_peak = if estimator == "peak" then 1 else 0
  let tle_sha_cited = pipe_field receipt "tle_sha256"
  let meas_sha_cited = pipe_field receipt "meas_sha256"
  let claimed_geo = pipe_field receipt "claimed_geo"
  let fc = parse_float (pipe_field receipt "fc_hz")

  -- (1) BIND the staged artifacts to what the receipt cited (digest equality).
  let tle_raw = read_file "/tmp/lg_verify_tle.txt"
  let meas_raw = read_file "/tmp/lg_verify_meas.txt"
  -- TLE digest: shasum -a 256 of "l1\nl2\n" (rollup: printf '%s\n%s\n' L1 L2). Reproduce by
  -- stripping any trailing newline noise and re-joining the two TLE lines with a trailing \n each.
  let tlines = split "\n" tle_raw
  let l1 = head tlines
  let l2 = if (tail tlines) == [] then "" else head (tail tlines)
  let tle_canon = cat [l1, "\n", l2, "\n"]
  let tle_sha_calc = sha256_hex tle_canon
  -- measured-track digest: shasum -a 256 of the WHOLE file bytes (the BIND_MEAS file verbatim).
  let meas_sha_calc = sha256_hex meas_raw

  let tle_ok = if tle_sha_calc == tle_sha_cited then 1 else 0
  let meas_ok = if meas_sha_calc == meas_sha_cited then 1 else 0

  -- (2) reproduce the eval point from the measured track + times + committed t_shift (eval_idx=nw//2).
  -- Snapshot times are parsed as INTEGERS and subtracted in integer space (snap_int_at_k); only the
  -- final t_eval is a float (so it carries t_shift_s). This dodges the float self-loop miscompile.
  let meas_lines = split "\n" meas_raw
  let times_raw = read_file "/tmp/lg_verify_times.txt"
  let time_lines = split "\n" times_raw
  let ndop = count_dop meas_lines 0
  let nsnap = count_snap time_lines 0
  let nw = if ndop < nsnap then ndop else nsnap
  let eval_idx = nw / 2
  let meas_val = dop_at_k meas_lines eval_idx want_peak 0
  let first_snap = snap_int_at_k time_lines 0 0
  let snap_eval = snap_int_at_k time_lines eval_idx 0
  let t_snap_eval_i = snap_eval - first_snap
  let t_eval_unix = round_ ((int_to_float first_snap) + (int_to_float t_snap_eval_i) + t_shift_s)

  -- (3) parse the CLAIMED observer geo (lat,lon,alt) -- the PREDICTION's observer (synthetic).
  let lat = parse_float (geo_field claimed_geo 0)
  let lon = parse_float (geo_field claimed_geo 1)
  -- alt: 3rd csv field with any trailing "km" stripped (e.g. "0.18km" -> "0.18").
  let alt_raw = geo_field claimed_geo 2
  let alt = parse_float (str_replace "km" "" alt_raw)

  -- (4) THE single SGP4 Doppler eval at t_eval_unix (now_unix anchor cancels analytically; we use
  -- t_eval_unix itself as the anchor so t0 maps exactly). predicted_total = predicted + const_off.
  -- Floats are routed THROUGH a scratch float array (acc) before the residual arithmetic -- the
  -- tdoa.rail:50-58 discipline: a float flowing straight out of doppler_at_unix into a subtraction
  -- can trip the self-loop miscompile, so we land it in acc[*] first.
  let pi = atan2 0.0 (0.0 - 1.0)
  let twopi = pi * 2.0
  let d2r = pi / 180.0
  let mu = 398600.4418
  let re = 6378.137
  let j2 = 0.0010826267
  let e = float_arr_new 26 0.0
  let o = float_arr_new 3 0.0
  let acc = float_arr_new 4 0.0
  let _ = set_observer e lat lon alt d2r twopi mu re j2 fc
  let _ = set_now_unix e t_eval_unix
  let _ = set_elements_from_tle e l1 l2
  let _ = float_arr_set acc 0 (doppler_at_unix e t_eval_unix o)
  let _ = float_arr_set acc 1 (const_off_hz)
  let _ = float_arr_set acc 2 (meas_val)
  let predicted_dop = float_arr_get acc 0
  let _ = float_arr_set acc 3 ((float_arr_get acc 0) + (float_arr_get acc 1))
  let predicted_total = float_arr_get acc 3
  let recomputed_f = fdiff (float_arr_get acc 3) (float_arr_get acc 2)
  let recomputed_hz = float_to_int recomputed_f

  -- (4b) FULL-PASS RMS re-run -- the WAVE C teeth. The SIGNED verdict physics_ok gates on
  -- residual_rms_hz <= rms_tol_hz (the robust discriminator), but the single point above only
  -- reproduces residual_hz (which is near-zero-information at TCA / eval_idx=nw/2). Recompute the
  -- RMS over EVERY window from the SAME cited TLE+geo+track+const_off and RE-DERIVE physics_ok, so a
  -- forged residual_rms_hz/physics_ok riding an honest single point can no longer pass verification.
  let sacc = float_arr_new 1 0.0
  let _ = rms_accum e o meas_lines time_lines first_snap t_shift_s const_off_hz want_peak nw 0 acc sacc
  let mean_sq = (float_arr_get sacc 0) / (int_to_float nw)
  let recomputed_rms_hz = float_to_int (sqrt mean_sq)
  let committed_rms_hz = parse_int (pipe_field receipt "residual_rms_hz")
  let rms_tol_hz = parse_int (pipe_field receipt "rms_tol_hz")
  let committed_physok = parse_int (pipe_field receipt "physics_ok")
  let rms_drift = if recomputed_rms_hz > committed_rms_hz then recomputed_rms_hz - committed_rms_hz else committed_rms_hz - recomputed_rms_hz
  let rms_within = if rms_drift <= repro_tol_hz then 1 else 0
  let rederived_physok = if recomputed_rms_hz <= rms_tol_hz then 1 else 0
  let physok_match = if rederived_physok == committed_physok then 1 else 0

  -- (5) the verdict: |recomputed - committed residual_hz| <= repro_tol_hz, AND both digests bind.
  let drift = if recomputed_hz > residual_hz then recomputed_hz - residual_hz else residual_hz - recomputed_hz
  let within = if drift <= repro_tol_hz then 1 else 0

  let _ = print (cat ["  physics  line ", show idx, ": tle_digest=", show tle_ok, " meas_digest=", show meas_ok, " est=", estimator, " t_eval_unix=", show_float t_eval_unix])
  let _ = print (cat ["  physics  predicted_dop=", show_float predicted_dop, " + const_off=", show_float const_off_hz, " = ", show_float predicted_total, " Hz ; measured=", show_float meas_val, " Hz"])
  let _ = print (cat ["  physics  recomputed_residual=", show recomputed_hz, " Hz  committed residual_hz=", show residual_hz, " Hz  drift=", show drift, " repro_tol=", show repro_tol_hz, " Hz"])
  let _ = print (cat ["  physics  recomputed_rms=", show recomputed_rms_hz, " Hz  committed residual_rms_hz=", show committed_rms_hz, " Hz  rms_drift=", show rms_drift, " ; rederived physics_ok=", show rederived_physok, " committed=", show committed_physok])

  if tle_ok == 0 then
    let _ = print (cat ["==> FAIL at line ", show idx, ": physics residual unreproducible (staged TLE sha256 ", tle_sha_calc, " != cited ", tle_sha_cited, ")"])
    0
  else if meas_ok == 0 then
    let _ = print (cat ["==> FAIL at line ", show idx, ": physics residual unreproducible (staged measured-track sha256 ", meas_sha_calc, " != cited ", meas_sha_cited, ")"])
    0
  else if within == 0 then
    let _ = print (cat ["==> FAIL at line ", show idx, ": physics residual unreproducible (recomputed ", show recomputed_hz, " Hz vs committed ", show residual_hz, " Hz, drift ", show drift, " > repro_tol ", show repro_tol_hz, " Hz)"])
    0
  else if rms_within == 0 then
    let _ = print (cat ["==> FAIL at line ", show idx, ": physics RMS unreproducible (recomputed residual_rms_hz ", show recomputed_rms_hz, " Hz vs committed ", show committed_rms_hz, " Hz, drift ", show rms_drift, " > repro_tol ", show repro_tol_hz, " Hz)"])
    0
  else if physok_match == 0 then
    let _ = print (cat ["==> FAIL at line ", show idx, ": physics_ok FORGED (committed physics_ok=", show committed_physok, " but recomputed residual_rms_hz=", show recomputed_rms_hz, " Hz vs rms_tol_hz=", show rms_tol_hz, " Hz re-derives physics_ok=", show rederived_physok, ")"])
    0
  else 1

-- walk the ledger line list, threading the expected prev pointer.
--   idx        = 0-based index of head lines (for error reporting)
--   expect_prev= the chain_hash the current line's prev= MUST equal ("GENESIS" for line 0)
--   fact_blob  = FACT chain-hash MARKER blob (existence checks; single-parent stays byte-identical)
--   lines_blob = FACT-line lookup blob (resolves a parent chain_hash -> its full FACT line for
--                inner co-signature re-verification on MESH_WITNESS lines)
-- returns 1 if the whole remaining chain verifies, 0 (with a printed FAIL line) otherwise.
walk_lines lines idx expect_prev fact_blob lines_blob =
  if lines == [] then 1
  else
    let ln = head lines
    if not (is_ledger_line ln) then
      -- non-receipt line (e.g. trailing blank): skip without advancing idx semantics
      walk_lines (tail lines) idx expect_prev fact_blob lines_blob
    else
      let receipt = field_val ln "receipt"
      let sighex = field_val ln "sig"
      let signerhex = field_val ln "signer"
      let chainstored = field_val ln "chain_hash"

      -- (a) signature
      let sigok = check_sig receipt sighex signerhex
      -- (b) chain_hash re-derive
      let chaincalc = calc_chain receipt sighex
      let chainok = if chaincalc == chainstored then 1 else 0
      -- (c) prev pointer links to the previous line's chain_hash. A segment-boundary GENESIS
      --     (line 0 ONLY) may instead carry prev=SEG_GENESIS:<archived_segment_sha256>: when a
      --     chain is closed + restarted, the new chain's first receipt cryptographically commits
      --     to the closed segment's digest -- the closure is SIGNED into the chain, not merely
      --     documented. Structural acceptance here; re-hashing the named archive to confirm the
      --     digest matches is the next rung (cf. the physics RMS recompute).
      let prev = pipe_field receipt "prev"
      let is_seg_genesis = if idx == 0 then str_contains "SEG_GENESIS:" prev else 0
      let linkok = if prev == expect_prev then 1 else (if is_seg_genesis == 1 then 1 else 0)
      -- (d) INFERENCE derived_from resolution (FACT lines skip this check -> 1). resolve_derived_multi
      --     str_splits ";" so a two-parent (mesh) value requires BOTH parents to resolve; a
      --     single-parent value is identical to the old resolve_derived_from.
      let rtype = pipe_field receipt "type"
      let dfrom = pipe_field receipt "derived_from"
      let dfok =
        if rtype == "INFERENCE" then
          if dfrom == "" then 0
          else resolve_derived_multi fact_blob dfrom
        else 1
      -- (e) MESH inner co-signature re-verification (two-parent INFERENCE only; others -> 1).
      let innerok =
        if rtype == "INFERENCE" then
          if dfok == 1 then mesh_inner_ok lines_blob receipt
          else 1
        else 1
      let is_mesh = str_contains "MESH_WITNESS_RECEIPT" receipt
      -- (f) WAVE C PHYSICS RE-RUN: a PHYSICS_BINDING_RECEIPT (A.7) gets its single-point residual
      --     RECOMPUTED from the cited TLE+claimed_geo+committed alignment+measured track, and the
      --     result compared to the committed residual_hz within repro_tol_hz. Run ONLY after the
      --     sig/chain/prev/derived_from gates already pass (so a structurally broken line fails on
      --     the cheaper check first) -- physics_recompute is the EXPENSIVE check, gated last.
      --     A valid signature over a FABRICATED residual still FAILS here. Non-binding lines -> 1.
      let is_binding = str_contains "PHYSICS_BINDING_RECEIPT" receipt
      let gates_ok = if sigok == 1 then (if chainok == 1 then (if linkok == 1 then (if dfok == 1 then (if innerok == 1 then 1 else 0) else 0) else 0) else 0) else 0
      let physok =
        if is_binding == 1 then
          if gates_ok == 1 then physics_recompute receipt idx
          else 1
        else 1

      let _ = print (cat ["line ", show idx, "  type=", rtype, "  sig=", show sigok, " chain=", show chainok, " link=", show linkok, " derived_from=", (if rtype == "INFERENCE" then show dfok else "n/a"), " inner_sigs=", (if is_mesh then show innerok else "n/a"), " physics=", (if is_binding then show physok else "n/a")])

      if sigok == 0 then
        let _ = print (cat ["==> FAIL at line ", show idx, ": bad signature"])
        0
      else if chainok == 0 then
        let _ = print (cat ["==> FAIL at line ", show idx, ": chain_hash mismatch (stored ", chainstored, " calc ", chaincalc, ")"])
        0
      else if linkok == 0 then
        let _ = print (cat ["==> FAIL at line ", show idx, ": broken prev link (prev=", prev, " expected ", expect_prev, ")"])
        0
      else if dfok == 0 then
        let _ = print (cat ["==> FAIL at line ", show idx, ": unresolved inference parent (derived_from=", dfrom, ")"])
        0
      else if innerok == 0 then
        let _ = print (cat ["==> FAIL at line ", show idx, ": mesh inner co-signature failed (sigA/sigB over resolved FACT receipt)"])
        0
      else if physok == 0 then
        let _ = print (cat ["==> FAIL at line ", show idx, ": physics residual unreproducible (binding receipt; a valid signature over a fabricated residual FAILS the physics re-run)"])
        0
      else
        -- this line is good; next line's prev must equal THIS line's (verified) chain_hash
        walk_lines (tail lines) (idx + 1) chaincalc fact_blob lines_blob

verify_jsonl target =
  let _ = print (cat ["LEDGER WALK  ", target])
  let content = read_file target
  let lines = split "\n" content
  -- FACT chain-hash lookup blob for INFERENCE derived_from resolution. If the facts list
  -- is absent, resolve against the target ledger itself (catches dangling pointers; a
  -- pure-INFERENCE ledger with no listed FACT source would then reject every line, which
  -- is the honest outcome — name the FACT ledgers).
  let facts_list = read_file "/tmp/lg_verify_facts.txt"
  let fact_paths =
    if facts_list == "" then [target]
    else (split "\n" facts_list)
  -- fact_blob  = markers-only (existence checks; single-parent path byte-identical to before).
  -- lines_blob = full FACT lines keyed by chain_hash (Wave D inner co-signature re-verification).
  let fact_blob = build_fact_blob fact_paths
  let lines_blob = build_fact_lines_blob fact_paths
  let verdict = walk_lines lines 0 "GENESIS" fact_blob lines_blob
  let _ = print (cat ["==> LEDGER ", if verdict == 1 then "VALID (chain intact, all sigs + links + derived_from + inner co-sigs check out)" else "INVALID"])
  verdict

main =
  let target = field_or "/tmp/lg_verify_target.txt" ""
  let verdict =
    if target == "" then verify_single
    else verify_jsonl target
  0
