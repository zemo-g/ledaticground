-- ledaticground: attested LRPT DECODE-PRODUCT receipt (pure Rail) -- RECEIPT_CONTRACT v=2.
-- Ticket B0-LRPT-DECODE. Binds the DECODED LRPT product (the Reed-Solomon-corrected CADU
-- stream satdump deframes from a raw IQ capture) to the receiving node under an Ed25519
-- signature, REAL hash-chained, beacon-anchored, with round-trip verify + tamper detection.
--
-- WHY THIS EXISTS: iq_capture_attest.rail attests the RAW BYTES off the SDR (the product of a
-- CAPTURE is the bytes). It does NOT attest what those bytes DECODED TO. The LRPT decode --
-- "this capture RS-deframed to N CADUs, digest X" -- was the one roof product with no receipt:
-- a real picture of Earth on disk, unsigned. This signer closes that gap.
--
-- FACT, not INFERENCE (contract A.5 / E.1): "A CRC/BCS/RS/UW-verified decode = FACT with its
-- honesty bit." An LRPT CADU is a Reed-Solomon (255,223) corrected CCSDS VCDU by the time
-- satdump emits it, so a CADU count > 0 is a verified-decode FACT, exactly like RS41_DECODE.
-- The honesty bit is cadu_ok=<0|1> (the LRPT analogue of rs_ok). A 0-CADU pass (empty sky,
-- below Viterbi-lock SNR) is STILL signed with cadu_ok=0 -- "received, no lock" is itself a
-- fact, never dropped (A.3).
--
-- CUSTODY -> CAPTURE CORRESPONDENCE (contract A.6): this FACT carries input_sha256 = sha256 of
-- the raw IQ .bin. IF the same .bin is ALSO attested by iq_capture_attest.rail, this digest
-- EQUALS that capture FACT's product_sha256 -- the shared value lets anyone cross-check "this
-- decode is over exactly the attested capture bytes." HONEST SCOPE: that cross-check is NOT yet
-- automated -- verify.rail resolves derived_from (which FACTs don't carry), not input_sha256
-- against another ledger's product_sha256; and the correspondence only exists when the capture
-- is also attested (the sweep attest_lrpt_decode_all.sh mints the capture FACT first so it is).
-- So this is a CHECKABLE correspondence, not yet a verifier-enforced guarantee. No derived_from
-- is used (FACTs carry custody directly; derived_from is the INFERENCE link). The rendered
-- MSU-MR imagery is a deterministic downstream render of the
-- attested CADU stream -- anyone holding the CADUs + satdump reproduces the pictures, so the
-- honest reproducible commitment is over the .cadu frames, not the PNG bytes.
--
-- It mirrors the v=2 FACT idiom of src/iq_capture_attest.rail + src/rs41_attest.rail verbatim
-- (field_or, join "|", real prev=, append_line, legacy single-object), adds the A.3 honesty
-- bit cadu_ok between n= and the A.6 custody fields:
--   LRPT_DECODE_RECEIPT|v=2|type=FACT|node=..|station=..|band=..|geo=..|pulse_id=..|pulse_hex=..|
--     batch_start=..|batch_end=..|n=<cadus>|cadu_ok=<0|1>|code_sha256=..|input_sha256=..|
--     product_sha256=..|prev=..|signer=..
--
-- HONESTY (operator standing rules):
--   * geo stays PENDING_needs_GPS_PPS until a surveyed GPS-PPS fix lands. NEVER fabricated.
--   * pulse fetch failure -> pulse_id=PENDING_beacon_unreachable (NEVER 0, NEVER wall-clock).
--   * pulse_hex / all digests travel as HEX STRINGS (char_from_int(0)=="" NUL-drop trap):
--     the driver shasums the binary .cadu/.bin and stages the hex; this signer never pulls
--     NUL-bearing binary through a Rail string.
--   * custody/product FAIL CLOSED to PENDING_no_*_hash if the driver did not stage them.
--   * cadu_ok FAILS CLOSED to 0 if the driver did not stage it (no silent "1").
--   * batch_start/batch_end are capture-window BOUNDS (provenance), NOT the attestation clock.
--   * REAL hash-chaining: prev = chain_hash of the prior ledger line, GENESIS only on line 1.
--
-- DEV signing key: the distinct, clearly-labeled LRPT-DECODE DEV seed from contract E.3
-- (1cad..0000 -- "lrpt cadu"). Distinct from every other stream (AIS a15a.., ACARS ac3a..,
-- beacon 9012.., IQ_CAPTURE c0de.., binding b14d.., mesh e54e..). NOT a production authority.
--
-- Idempotent on the same decode: the rollup driver re-signs the SAME .bin+.cadu -> identical
-- input_sha256/product_sha256, and skips re-appending if the cursor already covers them.
--
-- Run via the flock-serialized wrapper so stdlib crypto's nested relative imports resolve:
--   bash scripts/railrun.sh <ledaticground>/src/lrpt_decode_attest.rail

import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"
import "stdlib/file.rail"

-- field_or: read a /tmp (or data/) staging file, strip trailing newline; if absent/empty
-- fall back to the honest default. Verbatim idiom from iq_capture_attest.rail.
field_or path def =
  let v = str_replace "\n" "" (read_file path)
  if v == "" then def else v

main =
  -- DEV signing key -- the distinct, clearly-labeled LRPT-DECODE DEV seed (64-hex) from the
  -- contract dev-seed table (E.3): the 0x1cad "lrpt cadu" byte pattern, distinct from every
  -- other stream. NOT a production key.
  let seed = hex_to_bytes "1cad1cad1cad1cad1cad1cad1cad1cad1cad1cad1cad1cad1cad1cad1cad0000"
  let pk = ed25519_pk_from_sk seed
  let pk_hex = bytes_to_hex pk 32

  -- product_sha256: the sha256 of the deframed CADU stream (.cadu), STAGED AS HEX by the
  -- rollup driver (shasum -a 256 of <bin>.satdump/*.cadu). The signer does NOT read the .cadu
  -- itself -- the driver shasums it and stages the hex, so we never pull NUL-bearing binary
  -- through a Rail string. FAIL CLOSED to a PENDING marker if absent (a 0-CADU / no-lock pass).
  let product_hash = field_or "/tmp/lrpt_decode_product_sha256.txt" "PENDING_no_product_hash"

  -- custody fields (contract A.6, Wave A rung 3), all staged as hex by the driver:
  --   code_sha256  = shasum -a 256 of THIS signer's .rail source (binds the source text).
  --   input_sha256 = shasum -a 256 of the raw IQ .bin -- the SAME digest the iq_capture FACT
  --                  committed as its product_sha256 (the cryptographic capture<->decode link).
  let code_hash = field_or "/tmp/lrpt_decode_code_sha256.txt" "PENDING_no_code_hash"
  let input_hash = field_or "/tmp/lrpt_decode_input_sha256.txt" "PENDING_no_input_hash"

  -- A.3 honesty bit: cadu_ok=1 iff the decode produced RS-corrected CADUs (count > 0). Staged
  -- by the driver. FAIL CLOSED to "0" (no silent pass). A 0-CADU pass is signed with cadu_ok=0.
  let cadu_ok = field_or "/tmp/lrpt_decode_cadu_ok.txt" "0"

  -- beacon pulse (SHARED staging, by the shell wrapper, per contract C). HONEST PENDING
  -- fallback on any fetch failure -- the receipt is STILL signed + chained.
  let pulse_id = field_or "/tmp/lg_pulse_id.txt" "PENDING_beacon_unreachable"
  let pulse_hex = field_or "/tmp/lg_pulse_hex.txt" "PENDING_beacon_unreachable"

  -- REAL hash-chaining: prev = chain_hash of the prior ledger line (GENESIS only on line 1).
  -- Staged by the driver from tail -1 of data/lrpt_decode_receipts.jsonl.
  let prev = field_or "/tmp/lrpt_decode_prev_sha.txt" "GENESIS"

  -- capture-window BOUNDS + CADU count -- staged by the driver. Bounds are provenance (the
  -- .bin mtime: WHEN the bytes were captured), NOT the attestation clock. n = CADU count.
  let batch_start = field_or "/tmp/lrpt_decode_batch_start.txt" "PENDING"
  let batch_end = field_or "/tmp/lrpt_decode_batch_end.txt" "PENDING"
  let nstr = field_or "/tmp/lrpt_decode_batch_n.txt" "0"

  -- node identity is file-driven (sanitized: region only, no street address). Precise lat/lon
  -- is PENDING until GPS-PPS -- receiver geolocation is not asserted, only node identity + band.
  let sta = field_or "/Users/ledaticempire/projects/ledaticground/data/station_name.txt" "ledaticground-roof"
  let node = sta
  -- band: the capture's RF band, staged by the driver from the IQ schedule; honest PENDING
  -- if the driver could not determine it (never a fabricated frequency).
  let band = field_or "/tmp/lrpt_decode_band.txt" "LRPT-band-PENDING"
  let geo = field_or "/Users/ledaticempire/projects/ledaticground/data/station_geo.txt" "PENDING_needs_GPS_PPS"

  -- v=2 FACT LRPT_DECODE_RECEIPT -- field order LOAD-BEARING (sig is over this EXACT string).
  -- A.3 honesty bit cadu_ok sits after n=; A.6 custody (code_sha256, input_sha256) between it
  -- and product_sha256=.
  let receipt = join "|" ["LRPT_DECODE_RECEIPT", "v=2", "type=FACT", cat ["node=", node], cat ["station=", sta], cat ["band=", band], cat ["geo=", geo], cat ["pulse_id=", pulse_id], cat ["pulse_hex=", pulse_hex], cat ["batch_start=", batch_start], cat ["batch_end=", batch_end], cat ["n=", nstr], cat ["cadu_ok=", cadu_ok], cat ["code_sha256=", code_hash], cat ["input_sha256=", input_hash], cat ["product_sha256=", product_hash], cat ["prev=", prev], cat ["signer=", pk_hex]]
  let msg = string_to_bytes receipt
  let mlen = string_length_bytes receipt
  let sig = ed25519_sign seed msg mlen
  let sig_hex = bytes_to_hex sig 64

  let verify_ok = ed25519_verify pk msg mlen sig
  let tstr = cat [receipt, "X"]
  let tmsg = string_to_bytes tstr
  let tlen = string_length_bytes tstr
  let tamper_ok = ed25519_verify pk tmsg tlen sig
  let chain_hash = sha256_hex (cat [receipt, "|sig=", sig_hex])

  let _ = print (cat ["RECEIPT  ", receipt])
  let _ = print (cat ["CADU_OK  ", cadu_ok])
  let _ = print (cat ["CODE     ", code_hash])
  let _ = print (cat ["INPUT    ", input_hash])
  let _ = print (cat ["PRODUCT  ", product_hash])
  let _ = print (cat ["SIG      ", sig_hex])
  let _ = print (cat ["CHAIN    ", chain_hash])
  let _ = print (cat ["VERIFY   own-sig accepted = ", show verify_ok, " (want 1)"])
  let _ = print (cat ["TAMPER   modified-msg accepted = ", show tamper_ok, " (want 0)"])

  -- v=2 chained JSONL ledger line. Space-after-colon on every string field verify.rail reads
  -- (receipt/sig/signer/chain_hash) -- the cold verifier's field_val matches `"key": "`.
  let jsonline = cat ["{\"v\":2,\"type\":\"FACT\",\"receipt\": \"", receipt, "\",\"sig\": \"", sig_hex, "\",\"signer\": \"", pk_hex, "\",\"chain_hash\": \"", chain_hash, "\"}"]
  let _ = append_line "/Users/ledaticempire/projects/ledaticground/data/lrpt_decode_receipts.jsonl" jsonline
  let _ = print "APPENDED data/lrpt_decode_receipts.jsonl (v=2 chained LRPT_DECODE_RECEIPT line)"

  -- legacy single-object data/lrpt_decode_receipt.json (latest) for verify.rail backward compat.
  let jrec = join "\n" ["{", cat ["  \"receipt\": \"", receipt, "\","], cat ["  \"cadu_ok\": \"", cadu_ok, "\","], cat ["  \"product_sha256\": \"", product_hash, "\","], cat ["  \"sig\": \"", sig_hex, "\","], cat ["  \"signer\": \"", pk_hex, "\","], cat ["  \"chain_hash\": \"", chain_hash, "\""], "}"]
  let _ = write_file "/Users/ledaticempire/projects/ledaticground/data/lrpt_decode_receipt.json" jrec
  let _ = print "WROTE data/lrpt_decode_receipt.json"

  -- the latest LRPT-decode fact chain_hash -> data/lrpt_decode_fact_chain.txt. A future
  -- INFERENCE (e.g. a geodetic MSU-MR image-projection receipt) can name this as its
  -- derived_from ROOT. Mirrors iq_capture_attest.rail's data/iq_capture_fact_chain.txt.
  let _ = write_file "/Users/ledaticempire/projects/ledaticground/data/lrpt_decode_fact_chain.txt" chain_hash
  let _ = print "WROTE data/lrpt_decode_fact_chain.txt"
  0
