-- ledaticground WAVE B (rung 4 mechanism): PHYSICS-BINDING receipt (pure Rail) -- RECEIPT_CONTRACT v=2 sec A.7.
-- Emits ONE PHYSICS_BINDING_RECEIPT (type=INFERENCE) binding a MEASURED Doppler track to an
-- SGP4-PREDICTED Doppler curve for a CLAIMED orbit + CLAIMED observer geo. The bound product is
-- a SINGLE NUMBER: the residual (Hz) between the measured carrier-centroid Doppler and the
-- predicted SGP4 Doppler, EVALUATED AT THE COMMITTED ALIGNMENT (t_shift_s + const_off_hz).
--
-- THE CLAIM (operator doctrine, NEVER weaker, NEVER stronger):
--   physics_ok=1 means "the measured Doppler is CONSISTENT with the claimed orbit+geo WITHIN
--   tol_hz" -- it is a MECHANISM verdict, NEVER "verified true" / "the satellite was there."
--   A failed bind (|residual_hz| > tol_hz) is RECORDED with physics_ok=0, NEVER dropped:
--   "this node measured a Doppler track inconsistent with the claimed orbit" is itself a fact.
--   geo stays the literal PENDING_needs_GPS_PPS (the RECEIVER location is unattested). The
--   observer location used for the PREDICTION is the CLAIMED (synthetic) geo, carried in
--   claimed_geo with the _SYNTH suffix; numeric geo_lat/geo_lon live in /tmp ONLY, never committed.
--   note=binding_mechanism_validated_location_unattested makes the ceiling explicit on the wire.
--
-- THE FACT/INFERENCE WALL (sec A.2 / E.1-E.2): this is type=INFERENCE and MUST carry
-- derived_from=<fact_chain_hash> resolving to a FACT receipt. The FACT root is the IQ-CAPTURE
-- receipt's chain_hash, read from data/iq_capture_fact_chain.txt (written by the iq_capture
-- rollup). If that file is absent/empty we DO NOT silently sign -- we set
-- derived_from=UNCHAINED_NO_FACT and ABORT before signing (fail-loud at the attestation
-- boundary, paos-deep-audit rule; mirrors vessel_inference_attest.rail's UNCHAINED guard).
--
-- THE SINGLE-POINT RECOMPUTE (sec A.7 -- the load-bearing efficiency rule): the emitter COMMITS
-- the chosen Doppler alignment (t_shift_s + const_off_hz) -- the 240-step best_align SEARCH is
-- the SHELL ROLLUP's job (scripts/doppler_fit.py numpy). HERE in Rail we do exactly ONE SGP4
-- Doppler evaluation at the committed alignment via the doppler_range.rail QUERY math (inlined
-- verbatim below so this signer needs no extra .rail import), add the committed const_off_hz,
-- and compare to the measured centroid at that point. residual_hz = |predicted+off - measured|.
-- This is what Wave C re-runs (a cheap, deterministic single-point recompute, NOT a re-search).
--
-- residual_hz / tol_hz / residual_rms_hz / rms_tol_hz / repro_tol_hz are INTEGER Hz (float_to_int).
-- physics_ok=1 iff residual_rms_hz <= rms_tol_hz (the RMS-over-pass gate -- the single point is
-- fittable by a wrong orbit, so it is NOT the gate; residual_hz is the verifier repro anchor).
--
-- SEPARATE INFERENCE LEDGER FAMILY (sec B.6): appends data/physics_binding_receipts.jsonl
-- (chained v=2), writes legacy single-object data/binding_receipt.json, advances
-- data/chain/binding_prev.txt. NEVER mixed with the FACT ledgers.
--
-- DEV signing key: the PHYSICS_BINDING DEV seed from contract E.3 (b14d..0000). Clearly labeled
-- DEV seed, NOT a production attestation authority (production keys are a future V100 rung).
--
-- Run via the flock-serialized wrapper:  bash scripts/railrun.sh <abs>/src/binding_attest.rail
-- The TLE + claimed geo + measured track + committed alignment are staged under /tmp/binding_*
-- by scripts/attest_binding_rollup.sh (NEVER /tmp/dop_real.iq / /tmp/dop_meas_real.out -- those
-- belong to the LIVE doppler pipeline).

import "stdlib/sha256.rail"
import "stdlib/sha512.rail"
import "stdlib/x25519.rail"
import "stdlib/ed25519.rail"
import "stdlib/ed25519_scalar.rail"
import "stdlib/ed25519_sign.rail"
import "stdlib/file.rail"

foreign sin x -> float
foreign cos x -> float
foreign sqrt x -> float
foreign pow x y -> float
foreign atan2 y x -> float
foreign floor x -> float

-- field_or: read a staging/identity file, strip trailing newline; honest default if absent/empty.
-- Same idiom every ledaticground signer uses (ais_attest.rail line 34 / vessel_inference_attest.rail).
field_or path def =
  let v = str_replace "\n" "" (read_file path)
  if v == "" then def else v

-- |a - b|  (float abs via if/then -- the bundle.rail `within` / mesh_witness fdiff idiom).
fdiff a b = if a > b then a - b else b - a

-- ==================================================================================
-- SGP4-ish range/Doppler math -- VERBATIM from src/doppler_range.rail (the committed
-- primitive). Inlined (not imported) because doppler_range.rail owns its own `main` +
-- `field_or` + run_query, which would collide. The MATH is byte-identical so the
-- single-point Doppler here equals doppler_range.rail's QUERY-mode DOPQ value for the
-- same staged TLE+geo+fc -- exactly what the rollup's gen_tle_doppler.py fixture predicts
-- and what Wave C re-runs. Element/observer state lives in one 26-slot float array `e`.
-- ==================================================================================

asin_ x = atan2 x (sqrt (1.0 - x * x))
fmod_ a b = a - (floor (a / b)) * b

kepler_iter e m ecur k =
  if k == 0 then ecur
  else
    let f = ecur - e * (sin ecur) - m
    let fp = 1.0 - e * (cos ecur)
    let enext = ecur - f / fp
    kepler_iter e m enext (k - 1)

solve_kepler e m = kepler_iter e m m 8

gmst_rad jd d2r =
  let d = jd - 2451545.0
  let t = d / 36525.0
  let g = 280.46061837 + 360.98564736629 * d + 0.000387933 * t * t - (t * t * t) / 38710000.0
  let gm = fmod_ g 360.0
  let gpos = if gm < 0.0 then gm + 360.0 else gm
  gpos * d2r

compute_elaz e t o =
  let a = float_arr_get e 0
  let ecc = float_arr_get e 1
  let incl = float_arr_get e 2
  let raan0 = float_arr_get e 3
  let argp0 = float_arr_get e 4
  let m0 = float_arr_get e 5
  let raandot = float_arr_get e 6
  let argpdot = float_arr_get e 7
  let mdot = float_arr_get e 8
  let jde = float_arr_get e 9
  let ox = float_arr_get e 10
  let oy = float_arr_get e 11
  let oz = float_arr_get e 12
  let ophi = float_arr_get e 13
  let olam = float_arr_get e 14
  let d2r = float_arr_get e 15
  let mm = m0 + mdot * t
  let raan = raan0 + raandot * t
  let argp = argp0 + argpdot * t
  let ea = solve_kepler ecc mm
  let r = a * (1.0 - ecc * (cos ea))
  let nu = atan2 ((sqrt (1.0 + ecc)) * (sin (ea / 2.0))) ((sqrt (1.0 - ecc)) * (cos (ea / 2.0)))
  let nu2 = nu * 2.0
  let xo = r * (cos nu2)
  let yo = r * (sin nu2)
  let cosO = cos raan
  let sinO = sin raan
  let cosw = cos argp
  let sinw = sin argp
  let cosi = cos incl
  let sini = sin incl
  let xeci = xo * ((cosO * cosw) - (sinO * sinw * cosi)) - yo * ((cosO * sinw) + (sinO * cosw * cosi))
  let yeci = xo * ((sinO * cosw) + (cosO * sinw * cosi)) - yo * ((sinO * sinw) - (cosO * cosw * cosi))
  let zeci = xo * (sinw * sini) + yo * (cosw * sini)
  let jd_obs = jde + t / 86400.0
  let g = gmst_rad jd_obs d2r
  let cg = cos g
  let sg = sin g
  let xe = xeci * cg + yeci * sg
  let ye = (0.0 - xeci) * sg + yeci * cg
  let ze = zeci
  let rx = xe - ox
  let ry = ye - oy
  let rz = ze - oz
  let slat = sin ophi
  let clat = cos ophi
  let slon = sin olam
  let clon = cos olam
  let east = (0.0 - slon) * rx + clon * ry
  let north = (0.0 - slat) * clon * rx - slat * slon * ry + clat * rz
  let up = clat * clon * rx + clat * slon * ry + slat * rz
  let rng = sqrt (rx * rx + ry * ry + rz * rz)
  let elr = asin_ (up / rng)
  let azr = atan2 east north
  let eldeg = elr / d2r
  let azd = azr / d2r
  let azpos = if azd < 0.0 then azd + 360.0 else azd
  let _ = float_arr_set o 0 eldeg
  let _ = float_arr_set o 1 azpos
  let _ = float_arr_set o 2 rng
  0

set_observer e lat_deg lon_deg alt_km d2r twopi mu re j2 fc =
  let phi = lat_deg * d2r
  let lam = lon_deg * d2r
  let sphi = sin phi
  let cphi = cos phi
  let ae = 6378.137
  let ff = 1.0 / 298.257223563
  let e2 = ff * (2.0 - ff)
  let nlat = ae / (sqrt (1.0 - e2 * sphi * sphi))
  let ox = (nlat + alt_km) * cphi * (cos lam)
  let oy = (nlat + alt_km) * cphi * (sin lam)
  let oz = (nlat * (1.0 - e2) + alt_km) * sphi
  let _ = float_arr_set e 10 ox
  let _ = float_arr_set e 11 oy
  let _ = float_arr_set e 12 oz
  let _ = float_arr_set e 13 phi
  let _ = float_arr_set e 14 lam
  let _ = float_arr_set e 15 d2r
  let _ = float_arr_set e 21 mu
  let _ = float_arr_set e 22 re
  let _ = float_arr_set e 23 j2
  let _ = float_arr_set e 24 twopi
  let _ = float_arr_set e 25 fc
  0

set_elements_from_tle e l1 l2 =
  let incd = parse_float (str_sub l2 8 8)
  let raand = parse_float (str_sub l2 17 8)
  let ecc = parse_float (cat ["0.", str_sub l2 26 7])
  let argpd = parse_float (str_sub l2 34 8)
  let mad = parse_float (str_sub l2 43 8)
  let mmd = parse_float (str_sub l2 52 11)
  let yy = parse_int (str_sub l1 18 2)
  let year = 2000 + yy
  let ddf = parse_float (str_sub l1 20 12)
  let jd_jan1 = int_to_float (367 * year - 7 * year / 4) + 1721044.5
  let jd_epoch = jd_jan1 + (ddf - 1.0)
  let d2r = float_arr_get e 15
  let twopi = float_arr_get e 24
  let mu = float_arr_get e 21
  let re = float_arr_get e 22
  let j2 = float_arr_get e 23
  let jd_now = float_arr_get e 20
  let n0 = mmd * twopi / 86400.0
  let a = pow (mu / (n0 * n0)) (1.0 / 3.0)
  let incl = incd * d2r
  let p = a * (1.0 - ecc * ecc)
  let rp = re / p
  let factor = 1.5 * j2 * rp * rp
  let cosi = cos incl
  let sini = sin incl
  let raandot = (0.0 - n0) * factor * cosi
  let argpdot = n0 * factor * (2.0 - 2.5 * sini * sini)
  let mdot = n0 * (1.0 + factor * (sqrt (1.0 - ecc * ecc)) * (1.0 - 1.5 * sini * sini))
  let t0 = (jd_now - jd_epoch) * 86400.0
  let _ = float_arr_set e 0 a
  let _ = float_arr_set e 1 ecc
  let _ = float_arr_set e 2 incl
  let _ = float_arr_set e 3 (raand * d2r)
  let _ = float_arr_set e 4 (argpd * d2r)
  let _ = float_arr_set e 5 (mad * d2r)
  let _ = float_arr_set e 6 raandot
  let _ = float_arr_set e 7 argpdot
  let _ = float_arr_set e 8 mdot
  let _ = float_arr_set e 9 jd_epoch
  let _ = float_arr_set e 17 t0
  0

set_now_unix e now_unix_f =
  let jd_now = now_unix_f / 86400.0 + 2440587.5
  let _ = float_arr_set e 19 now_unix_f
  let _ = float_arr_set e 20 jd_now
  jd_now

range_at e t o =
  let _ = compute_elaz e t o
  float_arr_get o 2

-- Doppler (Hz) at time t (s since epoch) via the IDENTICAL 1-second forward range
-- difference doppler_range.rail / doppler_predict.rail use:
--   dop = (range(t) - range(t+1s)) * fc / 299792.458 km/s   (approaching => positive).
doppler_at e t o =
  let r1 = range_at e t o
  let r2 = range_at e (t + 1.0) o
  let fc = float_arr_get e 25
  (r1 - r2) * fc / 299792.458

-- Doppler (Hz) at a given UNIX time (s) -- maps unix u to (t0 + (u - now_unix)), the
-- IDENTICAL epoch-offset doppler_range.rail's doppler_at_unix uses. THE single-point recompute.
doppler_at_unix e unix_f o =
  let now_unix = float_arr_get e 19
  let t0 = float_arr_get e 17
  let t = t0 + (unix_f - now_unix)
  doppler_at e t o

-- ==================================================================================

main =
  -- PHYSICS_BINDING DEV signing key -- the b14d..0000 seed (contract E.3 Wave-B row). Clearly
  -- labeled DEV seed, NOT a production attestation authority (production keys are a future V100 rung).
  let seed = hex_to_bytes "b14d14b14d14b14d14b14d14b14d14b14d14b14d14b14d14b14d14b14d140000"
  let pk = ed25519_pk_from_sk seed
  let pk_hex = bytes_to_hex pk 32

  -- ===== THE FACT-vs-INFERENCE WALL: resolve derived_from (fail-loud if no fact root) =====
  -- derived_from = the IQ-CAPTURE FACT chain_hash (a true chain link) from
  -- data/iq_capture_fact_chain.txt (written by the iq_capture rollup). If absent/empty we ABORT
  -- before signing (an inference receipt with no fact root is a wall violation a verifier rejects).
  let fact_chain = field_or "/Users/ledaticempire/projects/ledaticground/data/iq_capture_fact_chain.txt" ""
  let derived_from = if fact_chain == "" then "UNCHAINED_NO_FACT" else fact_chain
  let have_fact = if derived_from == "UNCHAINED_NO_FACT" then 0 else 1

  -- ===== STAGED PHYSICS INPUTS (all under /tmp/binding_* -- the rollup's namespace) =====
  -- Claimed observer geo (numeric, /tmp ONLY -- NEVER committed). Used for the PREDICTION only;
  -- the committed geo field stays PENDING_needs_GPS_PPS (receiver location unattested).
  let lat = parse_float (field_or "/tmp/binding_geo_lat.txt" "0.0")
  let lon = parse_float (field_or "/tmp/binding_geo_lon.txt" "0.0")
  let alt = parse_float (field_or "/tmp/binding_geo_alt.txt" "0.0")
  let fc = parse_float (field_or "/tmp/binding_fc.txt" "137100000.0")
  let now_unix = parse_float (field_or "/tmp/binding_now_unix.txt" "0.0")
  let l1 = str_replace "\n" "" (read_file "/tmp/binding_tle_l1.txt")
  let l2 = str_replace "\n" "" (read_file "/tmp/binding_tle_l2.txt")

  -- The COMMITTED alignment (the emitter commits these; the verifier does NOT re-search):
  --   t_shift_s   = AOS-uncertainty time shift the rollup's numpy best_align chose (s).
  --   const_off_hz= the best-fit constant carrier offset (SDR ppm + carrier error) numpy chose (Hz).
  -- t_eval_unix   = the absolute unix time the single-point residual is evaluated at
  --                 (rollup stages first_snap_unix + t_shift; the measured centroid at that point).
  -- meas_centroid_hz = the MEASURED carrier-centroid Doppler at t_eval (from doppler_real.rail).
  let t_shift_s = field_or "/tmp/binding_t_shift_s.txt" "0.0"
  let const_off_hz_str = field_or "/tmp/binding_const_off_hz.txt" "0.0"
  let const_off_hz = parse_float const_off_hz_str
  let t_eval_unix = parse_float (field_or "/tmp/binding_t_eval_unix.txt" "0.0")
  let meas_centroid_hz = parse_float (field_or "/tmp/binding_meas_centroid_hz.txt" "0.0")

  -- tolerances (INTEGER Hz on the wire; staged as ints by the rollup).
  let tol_hz_str = field_or "/tmp/binding_tol_hz.txt" "50"
  let repro_tol_hz_str = field_or "/tmp/binding_repro_tol_hz.txt" "25"
  let tol_hz = parse_float tol_hz_str
  -- repro_tol_hz is the verifier's reproduction band -- echoed verbatim (no Rail math on it here).

  -- RMS-over-pass + its gate (the ROBUST orbit discriminator). The single-point residual at the
  -- eval point is FITTABLE by a wrong orbit: the 2-param fit (t_shift+const_off) absorbs the error,
  -- and at TCA the Doppler is ~0 for ANY orbit -- so a wrong orbit can land a small single-point
  -- residual (grounding finding 2026-06-17). The FIT RMS over the whole pass is the real signal
  -- (wrong orbit ~1000+ Hz vs right orbit ~few Hz). physics_ok gates on the RMS; the single-point
  -- residual_hz stays in the receipt as the verifier's reproducibility anchor. (The verifier-side
  -- RMS recompute is a tracked rung; today verify.rail reproduces the single-point.)
  let residual_rms_hz = float_to_int (parse_float (field_or "/tmp/binding_residual_rms_hz.txt" "0"))
  let rms_tol_hz = float_to_int (parse_float (field_or "/tmp/binding_rms_tol_hz.txt" "100"))

  -- ===== THE SINGLE-POINT PHYSICS RECOMPUTE (one SGP4 Doppler eval, NOT a 240-step search) =====
  -- Build the element/observer state from the CLAIMED geo + TLE + fc, then evaluate the SGP4
  -- Doppler at t_eval_unix. predicted_total = predicted_dop + const_off_hz (the committed
  -- carrier offset). residual = |predicted_total - measured_centroid|.
  let pi = atan2 0.0 (0.0 - 1.0)
  let twopi = pi * 2.0
  let d2r = pi / 180.0
  let mu = 398600.4418
  let re = 6378.137
  let j2 = 0.0010826267
  let e = float_arr_new 26 0.0
  let o = float_arr_new 3 0.0
  let _ = set_observer e lat lon alt d2r twopi mu re j2 fc
  let _ = set_now_unix e now_unix
  let _ = set_elements_from_tle e l1 l2
  let predicted_dop = doppler_at_unix e t_eval_unix o
  let predicted_total = predicted_dop + const_off_hz
  let residual_f = fdiff predicted_total meas_centroid_hz
  -- INTEGER Hz on the wire.
  let residual_hz = float_to_int residual_f
  let tol_hz_int = float_to_int tol_hz
  -- physics_ok gates on the RMS-over-pass (robust), NOT the fittable single point: 1 iff
  -- residual_rms_hz <= rms_tol_hz. A FAILED bind is RECORDED with 0, never dropped.
  let physics_ok = if residual_rms_hz <= rms_tol_hz then 1 else 0

  -- ===== METADATA the rollup staged (echoed verbatim; never fabricated) =====
  -- claimed_geo carries the _SYNTH suffix (the observer is the synthetic placeholder); rollup
  -- stages the exact string. sat / orbit / fc_hz / tle_sha256 / meas_sha256 name precisely what
  -- orbit + measured product this binding rests on, so Wave C re-predicts against the same thing.
  let claimed_geo = field_or "/tmp/binding_claimed_geo.txt" "PENDING_no_claimed_geo"
  let sat = field_or "/tmp/binding_sat.txt" "UNKNOWN"
  let fc_hz_int_str = field_or "/tmp/binding_fc_hz_int.txt" "137100000"
  let orbit = field_or "/tmp/binding_orbit.txt" "UNKNOWN@UNKNOWN"
  let tle_sha256 = field_or "/tmp/binding_tle_sha256.txt" "PENDING_no_tle_hash"
  let meas_sha256 = field_or "/tmp/binding_meas_sha256.txt" "PENDING_no_meas_hash"
  let estimator = field_or "/tmp/binding_estimator.txt" "centroid"

  -- beacon anchor (sec C): unified staging files. Honest PENDING on fetch failure (still
  -- signed+chained). NEVER 0, NEVER wall-clock. pulse_hex travels as a hex string.
  let pulse_id = field_or "/tmp/lg_pulse_id.txt" "PENDING_beacon_unreachable"
  let pulse_hex = field_or "/tmp/lg_pulse_hex.txt" "PENDING_beacon_unreachable"

  -- real hash-chain: prev= is the prior binding chain_hash (advances across runs via
  -- data/chain/binding_prev.txt), or GENESIS for line 1.
  let prev = field_or "/Users/ledaticempire/projects/ledaticground/data/chain/binding_prev.txt" "GENESIS"

  -- batch provenance BOUNDS + window count. NOT the attestation clock. Staged by the rollup.
  let batch_start = field_or "/tmp/binding_batch_start.txt" "PENDING"
  let batch_end = field_or "/tmp/binding_batch_end.txt" "PENDING"
  let nstr = field_or "/tmp/binding_n.txt" "0"

  -- node / station identity is file-driven (sanitized: region only). geo PENDING until GPS-PPS.
  let sta = field_or "/Users/ledaticempire/projects/ledaticground/data/station_name.txt" "ledaticground-roof"
  let node = sta
  -- band is the A.7 per-kind constant.
  let band = "Doppler-binding-137.1MHz"
  let geo = field_or "/Users/ledaticempire/projects/ledaticground/data/station_geo.txt" "PENDING_needs_GPS_PPS"

  -- ===== FAIL-LOUD GUARD: never sign an inference with no fact root =====
  if have_fact == 0 then
    let _ = print "FATAL  UNCHAINED_NO_FACT: no iq_capture fact chain_hash at data/iq_capture_fact_chain.txt."
    let _ = print "FATAL  refusing to sign a PHYSICS_BINDING inference receipt with no fact root (FACT/INFERENCE wall)."
    let _ = print "       run scripts/attest_iq_capture_rollup.sh on the IQ first to mint the FACT root."
    1
  else
    -- ===== THE v=2 PHYSICS_BINDING_RECEIPT -- field order is LOAD-BEARING (sec A.7 verbatim) =====
    -- The Ed25519 signature is computed over this EXACT pipe string. derived_from is the first
    -- post-`n` field (matches the A.2 INFERENCE walk). tol_hz (NOT tolerance_hz); repro_tol_hz is
    -- a DISTINCT key. residual_hz/tol_hz/repro_tol_hz are INTEGER Hz. t_shift_s + const_off_hz are
    -- the MANDATORY committed alignment (so the verifier does a single-point recompute, not a search).
    let receipt = join "|" ["PHYSICS_BINDING_RECEIPT", "v=2", "type=INFERENCE", cat ["node=", node], cat ["station=", sta], cat ["band=", band], cat ["geo=", geo], cat ["pulse_id=", pulse_id], cat ["pulse_hex=", pulse_hex], cat ["batch_start=", batch_start], cat ["batch_end=", batch_end], cat ["n=", nstr], cat ["derived_from=", derived_from], cat ["physics_ok=", show physics_ok], cat ["estimator=", estimator], cat ["residual_hz=", show residual_hz], cat ["tol_hz=", show tol_hz_int], cat ["residual_rms_hz=", show residual_rms_hz], cat ["rms_tol_hz=", show rms_tol_hz], cat ["repro_tol_hz=", repro_tol_hz_str], cat ["sat=", sat], cat ["fc_hz=", fc_hz_int_str], cat ["orbit=", orbit], cat ["tle_sha256=", tle_sha256], cat ["meas_sha256=", meas_sha256], cat ["t_shift_s=", t_shift_s], cat ["const_off_hz=", const_off_hz_str], cat ["claimed_geo=", claimed_geo], "note=binding_mechanism_validated_location_unattested", cat ["product_sha256=", meas_sha256], cat ["prev=", prev], cat ["signer=", pk_hex]]
    let msg = string_to_bytes receipt
    let mlen = string_length_bytes receipt
    let sig = ed25519_sign seed msg mlen
    let sig_hex = bytes_to_hex sig 64

    let verify_ok = ed25519_verify pk msg mlen sig
    let tstr = cat [receipt, "X"]
    let tmsg = string_to_bytes tstr
    let tlen = string_length_bytes tstr
    let tamper_ok = ed25519_verify pk tmsg tlen sig
    let chain_hash = sha256_hex (cat [receipt, "|sig=", sig_hex])

    let _ = print (cat ["PREDICT  sgp4_dop=", show_float predicted_dop, " + const_off=", const_off_hz_str, " -> predicted_total=", show_float predicted_total, " Hz @ t_eval_unix=", field_or "/tmp/binding_t_eval_unix.txt" "0.0"])
    let _ = print (cat ["MEASURE  centroid=", show_float meas_centroid_hz, " Hz  (estimator=", estimator, ")"])
    let _ = print (cat ["RESIDUAL ", show residual_hz, " Hz  tol=", show tol_hz_int, " Hz  repro_tol=", repro_tol_hz_str, " Hz  (single-point repro anchor)"])
    let _ = print (cat ["PHYSOK   residual_rms_hz=", show residual_rms_hz, " Hz  rms_tol=", show rms_tol_hz, " Hz  -> physics_ok=", show physics_ok, " (gates on RMS-over-pass)"])
    let _ = print (cat ["PHYSICS  physics_ok=", show physics_ok, "  (1 iff residual_rms_hz <= rms_tol_hz, the RMS-over-pass gate; a FAILED bind is RECORDED with 0, never dropped)"])
    let _ = print (cat ["DERIVED  derived_from=", derived_from, "  (iq_capture FACT chain_hash)"])
    let _ = print (cat ["RECEIPT  ", receipt])
    let _ = print (cat ["SIG      ", sig_hex])
    let _ = print (cat ["CHAIN    ", chain_hash])
    let _ = print (cat ["VERIFY   own-sig accepted = ", show verify_ok, " (want 1)"])
    let _ = print (cat ["TAMPER   modified-msg accepted = ", show tamper_ok, " (want 0)"])

    -- v=2 chained JSONL line into the SEPARATE inference ledger family (sec B.6 -- never mixed with
    -- FACT ledgers). SPACE-AFTER-COLON on every string field verify.rail reads is LOAD-BEARING.
    -- Append via append_line (NEVER append_file -- not a runtime symbol).
    let jline = cat ["{\"v\":2,\"type\":\"INFERENCE\",\"receipt\": \"", receipt, "\",\"sig\": \"", sig_hex, "\",\"signer\": \"", pk_hex, "\",\"chain_hash\": \"", chain_hash, "\"}"]
    let _ = append_line "/Users/ledaticempire/projects/ledaticground/data/physics_binding_receipts.jsonl" jline
    let _ = print "APPENDED data/physics_binding_receipts.jsonl (v=2 INFERENCE, separate family)"

    -- legacy single-object data/binding_receipt.json (latest) for verify.rail backward compat.
    -- carries derived_from + physics_ok explicitly so a cold reader sees the verdict + fact root.
    let jrec = join "\n" ["{", "  \"type\": \"INFERENCE\",", cat ["  \"receipt\": \"", receipt, "\","], cat ["  \"derived_from\": \"", derived_from, "\","], cat ["  \"physics_ok\": \"", show physics_ok, "\","], cat ["  \"residual_hz\": \"", show residual_hz, "\","], cat ["  \"sig\": \"", sig_hex, "\","], cat ["  \"signer\": \"", pk_hex, "\","], cat ["  \"chain_hash\": \"", chain_hash, "\""], "}"]
    let _ = write_file "/Users/ledaticempire/projects/ledaticground/data/binding_receipt.json" jrec
    let _ = print "WROTE data/binding_receipt.json"

    -- advance the chain: this receipt's chain_hash becomes the next run's prev=.
    let _ = write_file "/Users/ledaticempire/projects/ledaticground/data/chain/binding_prev.txt" chain_hash
    let _ = print "WROTE data/chain/binding_prev.txt (chain advanced)"
    0
